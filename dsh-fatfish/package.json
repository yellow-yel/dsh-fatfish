{
  "name": "dsh-fatfish",
  "version": "0.5.0",
  "description": "给 DSH 的 agent 套上大肥鱼人格：会聊天、会记事、会查毒。人设/时段/情绪/红线，本地记忆自动抽取，恶意进程/启动项/文件哈希检查，病毒库可在线更新，零依赖不上传。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "fatfish",
    "fish",
    "大肥鱼",
    "memory",
    "antivirus",
    "security",
    "malware",
    "free-api"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "API_SETUP.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/plugin.mjs && node test/smoke.mjs && node test/privacy.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellow-yel/dsh-fatfish.git",
    "directory": "dsh-fatfish"
  },
  "homepage": "https://github.com/yellow-yel/dsh-fatfish/tree/master/dsh-fatfish#readme",
  "bugs": {
    "url": "https://github.com/yellow-yel/dsh-fatfish/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT"
}
